node_modules/
dist/
out/
build/
# electron-builder buildResources are committed inputs, not outputs
!apps/gui/build/
!apps/gui/build/icon.ico
*.tsbuildinfo
.DS_Store
Thumbs.db
sandbox/
.env
.env.local
# Electron build output
apps/gui/out/
apps/gui/dist/
apps/gui/release/
# any alternate electron-builder output dir (--config.directories.output),
# e.g. the release-check/ workaround in AGENTS.md §10 step 9
apps/gui/release-*/
sandbox-harness/
# per-ticket git worktrees (see kanmer-execute / kanmer-closeout skills)
.worktrees/
# local updater test feed config — never committed, never packaged
apps/gui/dev-app-update.yml
.kanmer/

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Machine-local agent config. `.mcp.json` hardcodes absolute paths to this
# machine's Kanmer install and board worktree; `.claude/skills/` is a local
# copy of the plugin skills (the canonical ones are plugins/kanmer/skills/).
# Both are untracked deliberately — and `scripts/release.mjs` counts untracked
# files as a dirty tree, so leaving them here blocks every release.
.mcp.json
.claude/skills/
