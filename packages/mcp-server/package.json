{
  "name": "@kanmer/mcp-server",
  "version": "0.1.0",
  "description": "Local stdio MCP server exposing the .kanmer store to AI agents (codex, Claude, any MCP client).",
  "type": "module",
  "bin": {
    "kanmer-mcp": "./dist/index.js",
    "kanmer-mcp-http": "./dist/http-cli.js",
    "kanmer-mcp-token": "./dist/remote-token-cli.js",
    "kanmer-mcp-remote": "./dist/remote-cli.js",
    "kanmer-doctor": "./dist/doctor-cli.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsup && tsup --config tsup.standalone.config.ts",
    "build:standalone": "tsup --config tsup.standalone.config.ts",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "doctor": "node dist/doctor-cli.js",
    "typecheck": "tsc --noEmit",
    "test:http": "node scripts/run-http-tests.mjs",
    "test:http:built": "node scripts/run-http-tests.mjs --assume-built",
    "smoke:doctor": "npm run build && node src/smoke-doctor.mjs"
  },
  "dependencies": {
    "@kanmer/core": "*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
