{
  "name": "@kanmer/gui",
  "version": "0.4.2",
  "description": "Kanmer desktop GUI — an Electron + React kanban board over the .kanmer file store.",
  "author": "Kanmer",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@kanmer/core": "*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "chokidar": "^3.6.0",
    "electron": "^31.3.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^25.0.1",
    "marked": "^14.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "smol-toml": "^1.8.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  }
