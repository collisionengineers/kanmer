{
  "manifest_version": "0.3",
  "name": "kanmer",
  "display_name": "Kanmer",
  "version": "0.3.7",
  "description": "Headless Kanmer board access for Claude Desktop and other MCPB hosts.",
  "author": {
    "name": "Collision Engineers"
  },
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "server/kanmer-mcp.cjs",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/kanmer-mcp.cjs",
        "--root",
        "${user_config.board_root}"
      ]
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "compatibility": {
    "platforms": [
      "win32"
    ],
    "runtimes": {
      "node": ">=20"
    }
  },
  "user_config": {
    "board_root": {
      "type": "directory",
      "title": "Kanmer board root",
      "description": "The directory containing the Kanmer board (.kanmer), normally the repository's .worktrees/kanmer directory.",
      "required": true
    }
  }
}
